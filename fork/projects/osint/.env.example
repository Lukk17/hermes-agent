# OSINT Runner — Environment Variables Template
# Copy to .env and fill in your API keys
# Services that need keys are checked gracefully (no key = skipped)

# ===== Email Discovery & Validation =====
HUNTER_API_KEY=                    # hunter.io - 25 searches/month (https://hunter.io/api)
HIBP_API_KEY=                      # haveibeenpwned.com - paid (https://haveibeenpwned.com/api)
ABSTRACT_API_KEY=                  # abstractapi.com - 100/month email+phone validation (https://app.abstractapi.com)
EMAILREP_API_KEY=                  # emailrep.io - free, no key needed

# ===== Phone Validation =====
NUMVERIFY_API_KEY=                 # numverify.com - 100/month (https://numverify.com)
# (Uses ABSTRACT_API_KEY above)

# ===== Domain & Infrastructure Recon =====
VIRUSTOTAL_API_KEY=               # virustotal.com - limited free (https://www.virustotal.com)
URLSCAN_API_KEY=                   # urlscan.io - free tier (https://urlscan.io)
OTX_API_KEY=                       # alienvault.com - free tier (https://otx.alienvault.com)
ABUSEIPDB_API_KEY=                # abuseipdb.com - 1000 lookups/day (https://www.abuseipdb.com)
CENSYS_API_KEY=                   # censys.io - limited free (https://search.censys.io)
IPQS_API_KEY=                     # ipqualityscore.com - 5000/month (https://www.ipqualityscore.com)

# Paid/inactive infra (keep key name but not required):
# SHODAN_API_KEY=                 # shodan.io - very limited free
# SECURITYTRAILS_API_KEY=          # securitytrails.com - paid
# WHOISXML_API_KEY=               # whoisxmlapi.com - paid
# GREYNOISE_API_KEY=              # greynoise.io - 100 queries/day
# RISKIQ_API_KEY=                 # riskiq.com - not working, removed
# BINARY_EDGE_API_KEY=            # defunct
# CLEARBIT_API_KEY=                # defunct

# ===== Breach & Leak Databases =====
DEHASHED_API_KEY=                 # dehashed.com - very limited free (https://dehashed.com)
BREACHDIRECTORY_VIA_RAPIDAPI_API_KEY=  # breachdirectory.org via RapidAPI (https://rapidapi.com/breachdirectory/api/breachdirectory)
# LEAKCHECK_API_KEY=              # leakcheck.io - paid subscription
# SNUSBASE_API_KEY=               # snusbase.com - no API

# ===== GitHub & Code Search =====
GITHUB_TOKEN=                      # github.com - optional, increases rate limit (https://github.com/settings/tokens)
# GREP_APP_API_KEY=               # grep.app - no API key

# ===== Misc =====
COMPANIES_HOUSE_API_KEY=          # UK companies house free API (https://developer.companyhouse.gov.uk/)
# CRXCAVATOR_API_KEY=             # crxcavator.io - defunct
