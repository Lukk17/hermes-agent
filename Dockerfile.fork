# Tools + Python version manager layered on top of the upstream hermes-agent image.
#
# This Dockerfile is the "tools" image. The base image (hermes-agent:upstream) is
# built from the upstream Dockerfile by the `upstream-base` compose service
# (profile `build`) and includes:
#   - Debian 13.4 (trixie) base
#   - Python 3.13.5 in /opt/hermes/.venv (used by the hermes runtime)
#   - uv at /usr/local/bin/uv (used to manage the hermes venv)
#   - Node 26 + npm + Playwright
#   - s6-overlay supervision tree
#
# This layer adds the project-specific tooling that the fork's projects need
# but the upstream image does not ship:
#   - apt packages for OSINT (libxml2, libxslt, nmap, masscan, libpcap, tor, golang-go, etc.)
#   - pyenv (Python version manager)
#   - Python 3.11 (used by hermes-data/projects/crypto-monitor)
#   - Python 3.12 (used by hermes-data/projects/osint)
#   - TUI chown fix (the original reason this Dockerfile existed; see git log)
#
# The same image serves BOTH services in docker-compose.override.yml. The
# gateway runs hermes + cron + project scripts. The dashboard runs the
# web UI on port 9119. Both use the same image because hermes' gateway
# and dashboard are two entry points of the same Python module, not two
# separate runtimes.

ARG BASE_IMAGE=hermes-agent:upstream
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"

USER root

# ---------- OSINT apt dependencies ----------
# libxml2, libxslt, libpcap, libssl, libffi, libbz2, libsqlite3, zlib: required
# to compile lxml, scapy, sqlmap, and other Python extensions from source.
# build-essential + *-dev: compile any Python extension that ships source-only.
# golang-go: needed by some Amass modules and by SpiderFoot plugins.
# nmap, masscan, tor: actual OSINT scanning tools.
# libreadline-dev, libncursesw5-dev, tk-dev, xz-utils, liblzma-dev: build deps for
# Python 3.11/3.12 from source via pyenv.
# We deliberately skip python3-pip and python3-venv from system packages. The
# base image's Python 3.13 already has pip, and the project venvs we build
# with `uv` are independent of the system pip. Mixing system pip with
# pyenv-installed pythons leads to PATH confusion.
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        golang-go \
        libbz2-dev \
        libffi-dev \
        liblzma-dev \
        libncursesw5-dev \
        libpcap-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libxml2-dev \
        libxmlsec1-dev \
        libxslt1-dev \
        masscan \
        nmap \
        tk-dev \
        tor \
        xz-utils \
        zlib1g-dev \
        && rm -rf /var/lib/apt/lists/*

# ---------- pyenv (Python version manager) ----------
# pyenv lets us install arbitrary Python versions side by side. Project .venvs
# use uv-managed CPython under /opt/data/.local/share/uv/python/, not pyenv.
# pyenv 3.11 and 3.12 stay for tools that need older Python versions, and the
# upstream hermes runtime uses 3.13. Three Pythons in one image, no PATH
# conflicts because pyenv shims only fire on the requested version.
#
# Use the official pyenv.run installer script (more reliable than git clone
# when the network is flaky or rate-limited). pyenv has no prebuilt-Python
# downloader of its own (verified against pyenv/python-build's source: no
# PYENV_PYTHON_BUILD variable exists anywhere in it), so `pyenv install`
# compiles 3.11 and 3.12 from source via python-build, which already
# parallelizes the make step across every core (`MAKE_OPTS="-j $(nproc)"` by
# default) without any env var needed here. That compile is a one-time cost
# absorbed into the image build, not a per-run cost.
ENV PYENV_ROOT=/opt/pyenv
ENV PATH="/opt/hermes/bin:/opt/pyenv/shims:/opt/pyenv/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/bin:/usr/bin:/bin"
RUN rm -rf /opt/pyenv && curl -fsSL https://pyenv.run | PYENV_ROOT=/opt/pyenv bash
RUN pyenv --version
RUN pyenv install 3.11 && \
    pyenv install 3.12 && \
    pyenv global system 3.11 3.12 && \
    pyenv versions && \
    chmod -R a+rX,go-w /opt/pyenv

# ---------- TUI chown fix (the original reason this Dockerfile existed) ----------
# The upstream image seals /opt/hermes read-only for the hermes user. The
# dashboard's `--tui` flag triggers a rebuild of the React bundle that
# needs to write into /opt/hermes/ui-tui. chown back to the runtime user.
RUN chown -R hermes:hermes /opt/hermes/ui-tui

# ---------- /opt/data/.local/bin/hermes symlink ----------
# The hermes doctor checks for `~/.local/bin/hermes` to confirm the `hermes`
# command is callable outside the venv (Path.home() resolves to /opt/data,
# the hermes user's HOME per the upstream Dockerfile's
# `useradd -d /opt/data hermes`). Creating this symlink here, at image build
# time, does NOT survive: ./hermes-data:/opt/data bind-mounts a host
# directory over the whole of /opt/data at container start, which replaces
# the image layer's symlink with nothing, so `hermes doctor` reported it
# missing despite this very block having created it. The fix lives in a
# cont-init.d script instead (fork/docker/03-fork-local-bin-symlink), which
# runs against the live, mounted filesystem on every container start.
COPY fork/docker/03-fork-local-bin-symlink /etc/cont-init.d/03-fork-local-bin-symlink
RUN chmod +x /etc/cont-init.d/03-fork-local-bin-symlink

USER root
