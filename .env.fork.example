# Template for the fork-local docker-compose .env file.
#
# Usage:
#   1. Copy this file to .env (which is gitignored).
#   2. Fill in the values you actually use. Leave the rest blank or delete
#      them. Compose passes empty strings as empty env vars, which is
#      harmless for skills that gracefully no-op without their key.
#   3. Run `docker compose up -d`.
#
# This file lists every key the fork's own .env carries. Only the keys that
# appear under `gateway.environment:` in docker-compose.override.yml are
# actually forwarded into the container; the rest are documented here because
# they belong to the same deployment and are read elsewhere.
#
# See fork/NOTE-1-install.md for the walkthrough and fork/NOTE-3-discord.md
# for what each Discord variable is consumed by.

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# NOT forwarded by compose. Hermes strips provider and messaging credentials
# from every subprocess it spawns, so a passthrough here would not reach them;
# hermes-data/.env is the file every hermes process re-reads at startup.
# Put the real key there instead. Reasoning: fork/NOTE-3-discord.md.
MINIMAX_API_KEY=

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
# NOT forwarded by compose, for the same subprocess reason as above. The
# real token lives in hermes-data/.env.
# Every other Discord setting (allowlists, home channel, mention and thread
# behaviour) belongs in hermes-data/config.yaml under `discord:`.
DISCORD_BOT_TOKEN=

# How the bot syncs its Discord slash-command list on connect: safe | bulk | off.
# This one has no config.yaml path, so compose does forward it.
DISCORD_COMMAND_SYNC_POLICY=off

# -----------------------------------------------------------------------------
# Blockchain / on-chain data
# -----------------------------------------------------------------------------
BLOCKSCOUT_API_KEY=
ALCHEMY_API_KEY=
CRYPTOPANIC_API_KEY=

# -----------------------------------------------------------------------------
# Gmail OAuth client identity, for Hermes' own Google Workspace skill. The
# refresh token for THAT flow is NOT stored here; the skill writes it into
# google_token.json in the local credential store after the first OAuth
# authorization.
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Refresh token for the separate Gmail account the gmail-newsletter project
# reads from directly (not through Hermes' own Google Workspace skill, so it
# needs its own token rather than google_token.json). Obtain it once with an
# OAuth installed-app flow against that account and the client id/secret
# above, then paste the resulting refresh token here.
GMAIL_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Home Assistant tools (tools/homeassistant_tool.py)
# -----------------------------------------------------------------------------
# Long-lived access token: Home Assistant profile page, bottom of the page,
# "Long-Lived Access Tokens" section, "Create Token".
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# -----------------------------------------------------------------------------
# OSINT / threat-intel
# -----------------------------------------------------------------------------
HUNTER_API_KEY=
ABSTRACT_API_KEY=
EMAILREP_API_KEY=
NUMVERIFY_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
CENSYS_API_KEY=
IPQS_API_KEY=
DEHASHED_API_KEY=
BREACHDIRECTORY_VIA_RAPIDAPI_API_KEY=

# -----------------------------------------------------------------------------
# Local services (reachable from inside the container)
# -----------------------------------------------------------------------------
# host.docker.internal resolves to the Docker host. Works on Docker Desktop
# (Windows/Mac) out of the box. On native Linux, the override file already
# adds extra_hosts so this still resolves.
ASCEND_SCRAPPER_URL=http://host.docker.internal:7021/api/v2/web/read

# -----------------------------------------------------------------------------
# startup-seeker (optional)
# -----------------------------------------------------------------------------
# Product Hunt API key: https://api.producthunt.com/v2/docs (create a Product
# Hunt application, then generate a developer token).
PRODUCT_HUNT_API_KEY=

# -----------------------------------------------------------------------------
# Container UID/GID
# -----------------------------------------------------------------------------
# The container drops to the internal `hermes` user, UID 10000 by default. The
# stage2 hook remaps that user to HERMES_UID/HERMES_GID when they are set.
# PUID/PGID are accepted as aliases (LinuxServer.io / NAS parity).
#
# Whether you need them depends on the host, because only native Linux passes
# real file ownership through a bind mount:
#
#   Native Linux
#     REQUIRED. The kernel enforces the host owner's UID inside the container.
#     If UID 10000 does not own this checkout, every agent write under
#     /opt/data fails with EACCES: SOUL.md, memories, cron jobs, project files.
#
#   Windows, Docker Desktop
#     Not needed. The 9p/drvfs gateway mounts with uid=0,gid=0 and squashes
#     permissions, so any container UID can read and write the mount.
#     Measured on this machine: UID 10000 writes into /opt/data cleanly with
#     no HERMES_UID set anywhere.
#
#   macOS, Docker Desktop
#     Believed not needed. VirtioFS and gRPC-FUSE both translate ownership the
#     same way the Windows gateway does, so the container UID should not
#     matter. This has NOT been measured on a Mac. Check it in one command
#     before trusting it:
#       docker run --rm -u 10000 -v "$PWD/hermes-data:/opt/data" alpine:3.20 sh -c 'touch /opt/data/.uidprobe && echo WRITABLE && rm /opt/data/.uidprobe'
#     If that prints WRITABLE, leave HERMES_UID/HERMES_GID unset.
#
# Compose cannot run a shell, so it cannot compute these for you. The nearest
# thing to automatic is one command per machine, run once from the repo root.
# Compose then reads .env by itself on every `up`:
#
#   printf 'HERMES_UID=%s\nHERMES_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# Leave both commented on Windows and macOS. docker-compose.yml falls back to
# 10000/10000.
# HERMES_UID=1000
# HERMES_GID=1000

# -----------------------------------------------------------------------------
# Dashboard access (no reverse proxy)
# -----------------------------------------------------------------------------
# The dashboard is published to 127.0.0.1:9119 only, not reachable from the
# LAN. Local: http://localhost:9119. Remote: SSH tunnel from your laptop:
#   ssh -L 9119:localhost:9119 user@host
# then open http://localhost:9119 in your local browser.

# -----------------------------------------------------------------------------
# Optional LLM provider keys. Only needed if you go the API-key route
# instead of OAuth (MiniMax OAuth and Anthropic OAuth do not need keys).
# Uncomment and add the matching env passthrough line in
# docker-compose.override.yml under gateway.environment if you use these.
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
