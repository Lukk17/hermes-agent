{
  "mcpServers": {

    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },

    "playwright": {
      "type": "local",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },

    "chrome-devtools": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
